# API (optional)
# Local dev (npm run dev): leave VITE_API_BASE_URL unset — app uses /api, Vite proxies to port 3000
# Docker web-dev: set VITE_PROXY_TARGET=http://host.docker.internal:3000 in docker-compose (default)
# Direct API from browser (no proxy): VITE_API_BASE_URL=http://localhost:3000/api
# VITE_PROXY_TARGET=http://127.0.0.1:3000
VITE_API_TIMEOUT=10000
VITE_ENCRYPTION_KEY=
